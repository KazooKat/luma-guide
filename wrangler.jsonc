// Cloudflare Workers static assets: the site is plain files from `npm run build`, no Worker script runs.
// Deployed by .github/workflows/deploy.yml (`wrangler deploy`), or by hand with `npx wrangler deploy` after a build.
{
  "name": "luma-guide",
  "compatibility_date": "2026-10-14",
  // Served only on the custom domain (attached on the kazookat.dev zone); the workers.dev address is off.
  "workers_dev": false,
  "routes": [{ "pattern": "luma.kazookat.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist"
  }
}
